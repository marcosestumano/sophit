# Copie para .env.local e preencha com os dados do seu projeto Supabase
# (Painel → Project Settings → API)

NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Só no servidor. Usada pela rota /api/admin/delete-user. Nunca exponha no cliente.
SUPABASE_SERVICE_ROLE_KEY=
